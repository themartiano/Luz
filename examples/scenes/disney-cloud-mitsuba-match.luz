# Direct Luz reconstruction of the scene bundled with Disney's cloud dataset.
# The 36 mm / 35.00167 mm camera reproduces Mitsuba's 54.43 degree horizontal
# field of view at the reference image's exact 333:180 aspect ratio.
[settings]
resolution=333,180
samples=1024
adaptive=1
adaptiveminsamples=96
adaptivebackgroundminsamples=16
adaptivevolumeminsamples=128
adaptivethreshold=0.008
adaptivecheckinterval=8
maxlightbounces=64
view_transform=standard
exposure=0
contrast=1
bloom=0
denoise=1
sky=none
background=linear_srgb(0.03,0.07,0.23)
meters_per_unit=1
distanceblueness=0
outputfilename=disney-cloud-mitsuba-match.png

[materials]
material reference_ground {
type=lambertian
color=linear_srgb(0.2,0.2,0.2)
}

[scene]
camera main {
position=(648.064,-82.473,-63.856)
direction=(-642.043,182.516,20.177)
up=(0.273,0.962,-0.009)
focal_length_mm=35.00167
sensor_width_mm=36
sensor_height_mm=19.459459
pinhole=1
focus_distance=667.7862
}
directional_light sun {
direction=(-0.5826,-0.7660,-0.2717)
# Rec.709 luminance of the bundled linear-sRGB irradiance (2.6,2.5,2.3).
color=linear_srgb(2.6,2.5,2.3)
irradiance=2.50586
}
volume_grid disney_reference {
file=../../assets/volumes/wdas_cloud_half.luzvol
position=(-9.984,73.008,-42.64)
size=(413.088,280.8,509.184)
extinction=4
albedo=(1,1,1)
anisotropy=0.877
backscatter=0
forward_weight=1
droplet_size=0
multiple_scattering_falloff=1
multiple_scattering_compensation=0
quality=final
}
objects{
rectangle=(0,-1000,0),(0,1,0),40000,40000,material=reference_ground
}
