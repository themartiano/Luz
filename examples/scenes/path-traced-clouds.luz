# Physically lit, procedurally generated heterogeneous clouds over the Earth.
# For a fast draft, override with: --samples 8 --resolution 320x180
[settings]
resolution=960,540
samples=256
adaptive=1
adaptiveminsamples=32
adaptivethreshold=0.015
adaptivecheckinterval=8
maxlightbounces=8
view_transform=aces
exposure=-6.5
bloom=1
denoise=1
sky=atmosphere
atmosphere=0.18,6360000,6420000,7994,1200,20,10,0
atmosphere_sun_scale=0.5
meters_per_unit=1
outputfilename=path-traced-clouds.png
distanceblueness=0

[materials]
material earth_ground {
type=principled
base_color=srgb(0.16,0.19,0.12)
roughness=0.92
}

[scene]
camera main {
position=(0,6360120,0)
direction=(0,0.37,-1)
up=(0,1,0)
focal_length_mm=52
sensor_width_mm=36
sensor_height_mm=20.25
pinhole=1
focus_distance=10000
}
# Light direction is the direction sunlight travels. It also drives the sky.
directional_light sun {
direction=(0.78,-0.48,-0.35)
solar=1
}
objects{
sphere earth {
position=(0,0,0)
radius=6360000
material=earth_ground
}
cloud hero_cumulus {
type=cumulus
position=(-900,6365750,-17500)
size=(14500,9500,8000)
coverage=0.58
extinction=0.007
albedo=(0.996,0.998,1.0)
feature_scale=760
macro_scale=2.15
detail=0.12
erosion=0.04
puffiness=0.90
towering=0.96
dominance=0.84
overhang=0.72
fine_detail=0.96
multiple_scattering_falloff=0.68
multiple_scattering_compensation=0.72
shear_direction=(1,0,0)
detail_octaves=4
anisotropy=0.84
droplet_size=20
seed=1937
quality=cinematic
}
cloud foreground_bank {
type=stratocumulus
position=(0,6363800,-13500)
size=(32000,4200,13500)
coverage=0.82
extinction=0.006
albedo=(0.995,0.998,1.0)
feature_scale=520
macro_scale=1.05
detail=0.10
erosion=0.03
puffiness=0.78
towering=0.46
dominance=0.12
overhang=0.10
fine_detail=0.92
multiple_scattering_falloff=0.72
multiple_scattering_compensation=0.72
shear_direction=(1,0,0)
anisotropy=0.82
droplet_size=20
seed=811
quality=production
}
}
