# Disney Hyperion density and reference framing under Luz's physical atmosphere.
# The original reference-matched environment version remains in
# disney-cloud-hyperion-match.luz. This scene preserves its relative camera,
# volume placement, sun direction, and cloud controls, translated to Earth scale.
[settings]
resolution=999,540
samples=512
adaptive=1
adaptiveminsamples=48
adaptivebackgroundminsamples=16
adaptivevolumeminsamples=96
adaptivethreshold=0.01
adaptivecheckinterval=8
maxlightbounces=12
view_transform=aces
exposure=-6.5
contrast=1
bloom=0
denoise=1
sky=atmosphere
atmosphere=0.18,6360000,6420000,7994,1200,20,10,0
atmosphere_sun_scale=1.0
meters_per_unit=1
distanceblueness=0
outputfilename=disney-cloud-hyperion-atmosphere.png

[materials]
material earth_ground {
type=principled
base_color=srgb(0.13,0.17,0.10)
roughness=0.95
}

[scene]
camera main {
position=(648.064,6360180,-63.856)
direction=(-642.043,182.516,20.177)
up=(0.273,0.962,-0.009)
focal_length_mm=35.5
sensor_width_mm=36
sensor_height_mm=19.459459
pinhole=1
focus_distance=667.7862
}
directional_light sun {
direction=(-0.5826,-0.7660,-0.2717)
solar=1
}
volume_grid disney_hyperion {
file=../../assets/volumes/wdas_cloud_half.luzvol
position=(-10.208333,6360335.598,-43.541667)
size=(420,286.666667,513.333333)
extinction=4
albedo=(0.998,0.999,1)
anisotropy=0.877
backscatter=0
forward_weight=1
droplet_size=0
multiple_scattering_falloff=0.8
multiple_scattering_compensation=0.60
quality=final
}
objects{
sphere earth {
position=(0,0,0)
radius=6360000
material=earth_ground
}
}
