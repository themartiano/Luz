# Hyperion-look reconstruction using Disney's half-resolution density field.
# The grid placement restores the .luzvol index minimum and voxel size exactly;
# A 35.5 mm gate keeps the full wispy silhouette contained like the Hyperion plate.
[settings]
resolution=999,540
samples=512
adaptive=1
adaptiveminsamples=48
adaptivebackgroundminsamples=16
adaptivevolumeminsamples=96
adaptivethreshold=0.01
adaptivecheckinterval=8
maxlightbounces=12
view_transform=standard
exposure=0
contrast=1
bloom=0
denoise=1
sky=environment
environment=../../assets/environments/disney-hyperion-sky.ppm
environment_scale=1
environment_lighting=1
meters_per_unit=1
distanceblueness=0
outputfilename=disney-cloud-hyperion-match.png

[materials]
material reference_ground {
type=lambertian
color=linear_srgb(0.2,0.2,0.2)
}

[scene]
camera main {
position=(648.064,-82.473,-63.856)
direction=(-642.043,182.516,20.177)
up=(0.273,0.962,-0.009)
focal_length_mm=35.5
sensor_width_mm=36
sensor_height_mm=19.459459
pinhole=1
focus_distance=667.7862
}
directional_light sun {
direction=(-0.5826,-0.7660,-0.2717)
# Luz's production multiple-scattering control is calibrated to the brighter
# Hyperion plate while preserving the reference source chromaticity.
color=linear_srgb(2.6,2.5,2.3)
irradiance=3.15
}
volume_grid disney_hyperion {
file=../../assets/volumes/wdas_cloud_half.luzvol
# Header min (-528,-168,-720), dimensions (1008,688,1232), voxel 5/12.
position=(-10.208333,73.125,-43.541667)
size=(420,286.666667,513.333333)
extinction=4
albedo=(0.998,0.999,1)
anisotropy=0.877
backscatter=0
forward_weight=1
droplet_size=0
multiple_scattering_falloff=0.8
multiple_scattering_compensation=0.60
quality=final
}
objects{
rectangle=(0,-1000,0),(0,1,0),40000,40000,material=reference_ground
}
