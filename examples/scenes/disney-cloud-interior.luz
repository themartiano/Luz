# Camera-inside-medium stress test for interval handling and multiple scattering.
[settings]
resolution=960,540
samples=512
adaptive=1
adaptiveminsamples=48
adaptivebackgroundminsamples=16
adaptivevolumeminsamples=128
adaptivethreshold=0.01
adaptivecheckinterval=8
maxlightbounces=12
view_transform=aces
exposure=-9.0
bloom=0
denoise=1
sky=atmosphere
atmosphere=0.18,6360000,6420000,7994,1200,20,10,0
atmosphere_sun_scale=0.4
meters_per_unit=1
outputfilename=disney-cloud-interior.png
distanceblueness=0

[materials]
material earth_ground {
type=principled
base_color=srgb(0.13,0.17,0.10)
roughness=0.95
}

[scene]
camera main {
position=(4943,6363162,-14058)
direction=(0.86,0.22,0.46)
up=(0,1,0)
focal_length_mm=24
sensor_width_mm=36
sensor_height_mm=20.25
pinhole=1
focus_distance=3000
}
directional_light sun {
direction=(-0.5826,-0.7660,-0.2717)
color=(1,1,1)
irradiance=1361
}
objects{
sphere earth {
position=(0,0,0)
radius=6360000
material=earth_ground
}
volume_grid disney_hero {
file=../../assets/volumes/wdas_cloud_half.luzvol
position=(0,6365200,-14000)
size=(10500,7100,12900)
# The camera sits just inside an occupied boundary. This lower optical scale
# keeps tangent rays fog-filled while outward rays reach the broken edge, so the
# stress view retains depth gradients and shafts instead of flattening to gray.
extinction=0.012
albedo=(0.998,0.999,1.0)
droplet_size=20
multiple_scattering_falloff=0.8
multiple_scattering_compensation=0.72
quality=final
}
}
