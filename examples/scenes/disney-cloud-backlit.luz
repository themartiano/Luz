# Bright backlight stress test for Luz's authored sparse-volume transport.
[settings]
resolution=960,540
samples=512
adaptive=1
adaptiveminsamples=48
adaptivebackgroundminsamples=12
adaptivevolumeminsamples=96
adaptivethreshold=0.01
adaptivecheckinterval=8
maxlightbounces=10
view_transform=aces
exposure=-7.5
bloom=0
denoise=1
sky=atmosphere
atmosphere=0.18,6360000,6420000,7994,1200,20,10,0
atmosphere_sun_scale=0.6
meters_per_unit=1
outputfilename=disney-cloud-backlit.png
distanceblueness=0

[materials]
material earth_ground {
type=principled
base_color=srgb(0.13,0.17,0.10)
roughness=0.95
}

[scene]
camera main {
position=(16700,6361285,-14532)
direction=(-16294,4596,507)
up=(0.273,0.962,-0.009)
focal_length_mm=42
sensor_width_mm=36
sensor_height_mm=20.25
pinhole=1
focus_distance=19500
}
directional_light sun {
direction=(0.96,-0.20,-0.18)
color=(1.0,0.97,0.92)
irradiance=1361
}
objects{
sphere earth {
position=(0,0,0)
radius=6360000
material=earth_ground
}
volume_grid disney_hero {
file=../../assets/volumes/wdas_cloud_half.luzvol
position=(0,6365200,-14000)
size=(10500,7100,12900)
extinction=0.1575
albedo=(0.998,0.999,1.0)
droplet_size=20
multiple_scattering_falloff=0.8
multiple_scattering_compensation=0.72
quality=final
}
}
